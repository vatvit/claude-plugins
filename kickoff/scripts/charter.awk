# charter.awk — docs/project/charter.md from the answers. Run through kickoff_awk.
#
# Routing is by each question's "Goes to" cell (questionnaire §Reading the tables):
#   charter              → the overview list under the title
#   charter §<Section>   → that section, in the order the questionnaire first names it
#   charter decision     → the numbered decisions table
# An answer that is "not decided yet" goes to Open questions instead, wherever it was routed.
# Stale answers (their question no longer applies) are left out.

{ load() }

function cell(s) { gsub(/\|/, "\\|", s); return s }

# recovered(id) — " *(recovered from …)*" for an answer read from an existing project, "" otherwise,
# so the charter shows which decisions predate kickoff and which were taken at it.
function recovered(id) { if (from[id] == "") return ""; nrec++; return " *(recovered from " from[id] ")*" }


# route(goes) — "overview", "decision", "S:<name>", or "" when the charter is not a target.
# The marker is ASCII on purpose: § is two bytes in byte-oriented awks (busybox, mawk), and
# substr() on it there leaves half a character behind.
function route(goes,   g) {
    if (goes ~ /charter decision/) return "decision"
    if (match(goes, /charter §[^,;]+/)) { g = substr(goes, RSTART, RLENGTH); sub(/^charter §/, "", g); return "S:" trim(g) }
    if (goes ~ /(^|[ ,;])charter([,;]|$)/) return "overview"
    return ""
}

END {
    name = (ans["A1"] != "") ? ans["A1"] : "Project"
    print "---"
    print "title: Charter"
    print "description: What " name " is, what it must achieve, its scope, and the decisions taken at kickoff"
    print "---"
    print ""
    print "# " name " — charter"
    print ""
    if (ans["A2"] != "") { print ans["A2"] recovered("A2"); print "" }

    nsec = 0; nd = 0; no = 0; nov = 0
    for (i = 1; i <= nq; i++) {
        id = qid[i]; s = state_of(i)
        if (s != "answered" || id == "A1" || id == "A2") continue
        if (not_applicable(ans[id])) continue
        r = route(qgoes[i]); if (r == "") continue
        if (undecided(ans[id]) || r == "S:Open questions") { open[++no] = "**" qtext[i] "** " joined(id, "; "); continue }
        if (r == "overview") { nov++; ov[nov] = "- **" qtext[i] "** " joined(id, "; ") recovered(id); continue }
        if (r == "decision") {
            nd++   # its own statement: whether a subscript ++ runs before the right-hand side differs between awks
            w = (why[id] != "") ? cell(why[id]) : ""
            if (from[id] != "") { nrec++; w = w (w != "" ? "; " : "") "recovered from " cell(from[id]) }
            dec[nd] = "| D" nd " | **" cell(qtext[i]) "** " cell(joined(id, "; ")) " | " (w != "" ? w : "—") " |"
            # a decision that holds only until a trigger (C5 "Later — from …") is revisited then
            if (later_trigger(ans[id]) != "") { no++; open[no] = "**" qtext[i] "** revisit at: " later_trigger(ans[id]) }
            continue
        }
        sname = substr(r, 3)
        if (!(sname in sidx)) { sidx[sname] = ++nsec; sorder[nsec] = sname }
        k = sidx[sname]
        for (j = 1; j <= ansn[id]; j++) sbody[k] = sbody[k] (sbody[k] != "" ? "\n" : "") ansv[id, j]
        scount[k] += ansn[id]
    }

    for (k = 1; k <= nov; k++) print ov[k]
    if (nov) print ""
    for (k = 1; k <= nsec; k++) {
        print "## " sorder[k]; print ""
        if (scount[k] == 1) print sbody[k]
        else { n = split(sbody[k], lines, "\n"); for (j = 1; j <= n; j++) print "- " lines[j] }
        print ""
    }
    if (nd) {
        print "## Decisions"; print ""
        print "| # | Decision | Why |"; print "|---|---|---|"
        for (k = 1; k <= nd; k++) print dec[k]
        print ""
    }
    print "## Open questions"; print ""
    if (no) for (k = 1; k <= no; k++) print "- " open[k]
    else print "None at kickoff."
    print ""
    if (nrec) { print "*Marked recovered: read from the project as it stood when kickoff ran on it, and confirmed then. The rest were decided at kickoff.*"; print "" }
    print "*Generated by kickoff from `.kickoff-answers`. Decisions taken later are added to the table by hand.*"
}
