# quality.awk — docs/project/quality.md from the answers. Run through kickoff_awk.
#
# Every settled answer whose "Goes to" names `quality doc` (questionnaire §F) becomes a section
# headed by its question, in questionnaire order. A multi-select answer (an aspect's resulting set,
# the tools table) becomes a list. Prints nothing when no such answer is settled, so the scaffold
# writes no file for a project that never reached §F.

{ load() }

END {
    name = (ans["A1"] != "") ? ans["A1"] : "Project"
    for (i = 1; i <= nq; i++) {
        id = qid[i]
        if (qgoes[i] !~ /quality doc/ || settled(id) == "") continue
        h = qtext[i]; sub(/ \(pick any\)$/, "", h)
        body = body "## " h "\n\n"
        if (ansn[id] == 1) body = body ans[id] "\n\n"
        else { for (k = 1; k <= ansn[id]; k++) body = body "- " ansv[id, k] "\n"; body = body "\n" }
    }
    if (body == "") exit
    print "---"
    print "title: Quality"
    print "description: How " name " is checked: the quality level, the checks by aspect, what a red check stops, and the tools"
    print "---"
    print ""
    print "# " name " — quality"
    print ""
    printf "%s", body
    print "*Generated by kickoff from `.kickoff-answers`. The checks are set up by the dev harness task.*"
}
